{
  "schema": "assetslab_motion_v1",
  "motion_id": "walk",
  "title": "Walk — 8 帧标准行走",
  "description": "接触/过位/最低/最高关键帧驱动的标准行走循环：腿部跨步+抬脚（IK 屈膝），骨盆起伏+侧摆，躯干反向扭转，肩部带动摆臂，前倾保持动态平衡。",
  "frame_count": 8,
  "params": {
    "intensity": {
      "default": 1.0,
      "min": 0.0,
      "max": 1.5,
      "step": 0.05,
      "label": "力度协调",
      "desc": "主参数：协调步幅/起伏/摆臂等整体强度"
    },
    "stride": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "label": "步幅",
      "desc": "腿部前后跨步幅度（水平）"
    },
    "step_height": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "label": "步高",
      "desc": "摆动脚离地高度（IK 联动自然屈膝）"
    },
    "pelvis_bob": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "label": "骨盆起伏",
      "desc": "身体上下起伏幅度（过位最高、支撑最低）"
    },
    "pelvic_sway": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "label": "骨盆侧摆",
      "desc": "骨盆左右/前后摆动，躯干反向形成扭转"
    },
    "torso_lean": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "label": "前倾",
      "desc": "上身前倾幅度（行走动态平衡）"
    },
    "arm_swing": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "label": "摆臂",
      "desc": "摆臂幅度（肩部带动，与腿反向）"
    }
  },
  "signals": {
    "phase": {
      "phase": true
    },
    "swing": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "stride"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "swing_r": {
      "neg": {
        "signal": "swing"
      }
    },
    "lift": {
      "mul": [
        {
          "rect": {
            "sin": {
              "phase": true
            }
          }
        },
        {
          "sin": {
            "phase": true
          }
        },
        {
          "sin": {
            "phase": true
          }
        }
      ]
    },
    "lift_r": {
      "mul": [
        {
          "rect": {
            "neg": {
              "sin": {
                "phase": true
              }
            }
          }
        },
        {
          "neg": {
            "sin": {
              "phase": true
            }
          }
        },
        {
          "neg": {
            "sin": {
              "phase": true
            }
          }
        }
      ]
    },
    "bob": {
      "mul": [
        {
          "table": [
            3.0,
            0.0,
            -7.0,
            0.0,
            3.0,
            0.0,
            -7.0,
            0.0
          ]
        },
        {
          "param": "pelvis_bob"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "sway": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "pelvic_sway"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "lean": {
      "mul": [
        {
          "param": "torso_lean"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "arm": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "arm_swing"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "arm_r": {
      "neg": {
        "signal": "arm"
      }
    }
  },
