{
  "schema": "assetslab_motion_v1",
  "motion_id": "idle",
  "title": "Idle — 待机呼吸",
  "description": "呼吸待机：胸腔开合、耸肩、骨盆微沉、重心轻微偏移、手臂自然轻摆。",
  "frame_count": 8,
  "params": {
    "intensity": {
      "default": 1.0,
      "min": 0.0,
      "max": 1.5,
      "step": 0.05,
      "label": "力度协调",
      "desc": "主参数：协调呼吸/胸廓/耸肩等整体强度"
    },
    "breath": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "label": "呼吸",
      "desc": "呼吸起伏（骨盆微沉、头肩微动）"
    },
    "chest_expand": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "label": "胸廓",
      "desc": "肋骨外扩、胸腔开合幅度"
    },
    "shoulder_rise": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "label": "耸肩",
      "desc": "随呼吸的肩部起伏幅度"
    },
    "weight_shift": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "label": "重心",
      "desc": "轻微左右重心偏移"
    },
    "arm_sway": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "label": "手臂",
      "desc": "手臂自然轻摆幅度"
    }
  },
  "signals": {
    "phase": {
      "phase": true
    },
    "breath": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "breath"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "chest": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "chest_expand"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "shoulder": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "shoulder_rise"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "sway": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "weight_shift"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "arm": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "arm_sway"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "arm_r": {
      "neg": {
        "signal": "arm"
      }
    }
  },
  "root": {
    "dx": {
      "mul": [
        {
          "signal": "sway"
        },
        1.5
      ]
    },
    "dy": {
