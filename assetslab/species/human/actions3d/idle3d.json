        "mul": [
          {
            "signal": "shoulder"
          },
          -1.2
        ]
      }
    },
    "clavicle_right": {
      "y": {
        "mul": [
          {
            "signal": "shoulder"
          },
          -1.2
        ]
      }
    },
    "head": {
      "z": {
        "mul": [
          {
            "signal": "sway"
          },
          1.2
        ]
      }
    },
    "neck_mid": {
      "z": {
        "mul": [
          {
            "signal": "sway"
          },
          0.8
        ]
      }
    }
  },
  "ik3d": {
