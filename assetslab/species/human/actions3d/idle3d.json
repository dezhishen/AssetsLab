{
  "schema": "assetslab_motion3d_v1",
  "motion_id": "idle3d",
  "title": "Idle 3D — 呼吸待机",
  "description": "自然待机：胸廓呼吸起伏、重心微移、轻微耸肩、手臂自然垂手轻摆、头颈轻转。",
  "species": "human",
  "frame_count": 8,
  "params": {
    "intensity": {
      "default": 1.0,
      "min": 0.0,
      "max": 1.5,
      "label": "力度协调"
    },
    "breath": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "label": "呼吸"
    },
    "chest_expand": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "label": "胸廓"
    },
    "shoulder_rise": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "label": "耸肩"
    },
    "weight_shift": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "label": "重心"
    },
    "arm_sway": {
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "label": "手臂"
    }
  },
  "signals": {
    "phase": {
      "phase": true
    },
    "breath": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "breath"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "chest": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "chest_expand"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "shoulder": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "shoulder_rise"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "sway": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "weight_shift"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "arm": {
      "mul": [
        {
          "sin": {
            "phase": true
          }
        },
        {
          "param": "arm_sway"
        },
        {
          "param": "intensity"
        }
      ]
    },
    "arm_r": {
      "neg": {
        "signal": "arm"
      }
    }
  },
  "root3d": {
    "x": {
      "mul": [
        {
          "signal": "sway"
        },
        1.5
      ]
    },
    "y": {
      "mul": [
        {
          "signal": "breath"
        },
        -1.2
      ]
    }
  },
  "offsets3d": {
    "chest": {
      "y": {
        "mul": [
          {
            "signal": "breath"
          },
          -0.8
        ]
      }
    },
    "pelvis": {
      "x": {
        "mul": [
          {
            "signal": "sway"
          },
          1.2
        ]
      }
    },
    "hip_left": {
      "x": {
