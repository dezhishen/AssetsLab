          },
          -1.2
        ]
      }
    },
    "rib_upper_right": {
      "x": {
        "mul": [
          {
            "signal": "chest"
          },
          1.2
        ]
      }
    },
    "rib_lower_left": {
      "x": {
        "mul": [
          {
            "signal": "chest"
          },
          -0.9
        ]
      }
    },
    "rib_lower_right": {
      "x": {
        "mul": [
          {
