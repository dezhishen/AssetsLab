# ============================================================
# AssetsLab .gitignore
# Grouped by concern. Keep entries that match paths that may be
# regenerated on any branch; drop stale entries for retired assets.
# ============================================================

# --- Environment / toolchain ---
.tools/
.venv/
.venv*/

# --- Python caches ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Godot project cache ---
prototype/.godot/

# --- Generated / test artifacts (build outputs, never committed) ---
prototype/test_output/
run/
dist/

# --- Third-party reference assets (downloaded on demand, never committed) ---
third_party/rgs_modular_animated_characters/

# --- Godot import metadata ---
*.import

# --- OS junk ---
.DS_Store
Thumbs.db
