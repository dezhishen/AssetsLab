{
  "definition_id": "default",
  "title": "AssetsLab 骨架优先行走流水线（精简版）",
  "actions": [
    {
      "action_id": "skeleton.front",
      "title": "正面行走循环",
      "phase": "skeleton",
      "exec": [
        "stage",
        "front",
        "arms",
        "--renderer",
        "python",
        "--motion",
        "walk",
        "--stride",
        "{stride}",
        "--pelvis-bob",
        "{pelvis_bob}",
        "--arm-swing",
        "{arm_swing}",
        "--proportion-arm-length",
        "{arm_length}",
        "--proportion-leg-length",
        "{leg_length}",
        "--proportion-torso-length",
        "{torso_length}",
        "--proportion-shoulder-width",
        "{shoulder_width}",
        "--proportion-head-scale",
        "{head_scale}",
        "--proportion-height",
        "{height}"
      ],
      "params": {
        "stride": {"default": 1.0, "min": 0.0, "max": 2.5, "label": "步幅"},
        "pelvis_bob": {"default": 1.0, "min": 0.0, "max": 3.0, "label": "骨盆起伏"},
        "arm_swing": {"default": 1.0, "min": 0.0, "max": 2.0, "label": "摆臂"}
      },
      "depends": [],
      "collect": [
        "prototype/test_output/skeleton_pipeline/front_arm_swing_walk.gif"
      ],
      "description": "正面完整行走循环，可调整步幅、骨盆起伏、摆臂（体型在角色面板统一调整）"
    },
    {
      "action_id": "skeleton.side",
      "title": "右向侧面行走循环",
      "phase": "skeleton",
      "exec": [
        "stage",
        "side",
        "arms",
        "--renderer",
        "python",
        "--motion",
        "walk",
        "--stride",
        "{stride}",
        "--pelvis-bob",
        "{pelvis_bob}",
        "--arm-swing",
        "{arm_swing}",
        "--proportion-arm-length",
        "{arm_length}",
        "--proportion-leg-length",
        "{leg_length}",
        "--proportion-torso-length",
        "{torso_length}",
        "--proportion-shoulder-width",
        "{shoulder_width}",
        "--proportion-head-scale",
        "{head_scale}",
        "--proportion-height",
        "{height}"
      ],
      "params": {
        "stride": {"default": 1.0, "min": 0.0, "max": 2.5, "label": "步幅"},
        "pelvis_bob": {"default": 1.0, "min": 0.0, "max": 3.0, "label": "骨盆起伏"},
        "arm_swing": {"default": 1.0, "min": 0.0, "max": 2.0, "label": "摆臂"}
      },
      "depends": [
        "skeleton.front"
      ],
      "collect": [
        "prototype/test_output/skeleton_pipeline/side_arm_swing_walk.gif"
      ],
      "description": "右向侧面完整行走循环，可调整步幅、骨盆起伏、摆臂（体型在角色面板统一调整）"
    },
    {
      "action_id": "skeleton.back",
      "title": "背面行走循环",
      "phase": "skeleton",
      "exec": [
        "stage",
        "back",
        "legs",
        "--renderer",
        "python",
        "--motion",
        "walk",
        "--stride",
        "{stride}",
        "--pelvis-bob",
        "{pelvis_bob}",
        "--proportion-arm-length",
        "{arm_length}",
        "--proportion-leg-length",
        "{leg_length}",
        "--proportion-torso-length",
        "{torso_length}",
        "--proportion-shoulder-width",
        "{shoulder_width}",
        "--proportion-head-scale",
        "{head_scale}",
        "--proportion-height",
        "{height}"
      ],
      "params": {
        "stride": {"default": 1.0, "min": 0.0, "max": 2.5, "label": "步幅"},
        "pelvis_bob": {"default": 1.0, "min": 0.0, "max": 3.0, "label": "骨盆起伏"}
      },
      "depends": [
        "skeleton.side"
      ],
      "collect": [
        "prototype/test_output/skeleton_pipeline/back_legs_walk.gif"
      ],
      "description": "背面行走循环，可调整步幅、骨盆起伏（体型在角色面板统一调整）"
    },
    {
      "action_id": "test.smoke",
      "title": "无头冒烟测试",
      "phase": "test",
      "exec": [
        "test"
      ],
      "depends": [
        "skeleton.back"
      ],
      "collect": [],
      "description": "生成随机外观并校验全部资产，再跑 Godot 冒烟测试"
    },
    {
      "action_id": "capture.walk",
      "title": "捕获行走 GIF",
      "phase": "capture",
      "exec": [
        "capture-walk"
      ],
      "depends": [
        "test.smoke"
      ],
      "collect": [
        "prototype/test_output/movement_walk.gif"
      ],
      "description": "四方向行走 GIF 捕获"
    },
    {
      "action_id": "export.artifacts",
      "title": "导出 Godot 制品",
      "phase": "export",
      "exec": [
        "run-script",
        "export_artifacts.py",
        "--workflow-id",
        "{workflow_id}"
      ],
      "depends": [
        "capture.walk"
      ],
      "collect": [],
      "description": "打包 dist/<workflow_id>/ 制品包（atlas + manifest + GIF）供 Godot demo 使用"
    },
    {
      "action_id": "skin.verify",
      "title": "蒙皮绑定校验",
      "phase": "skin",
      "exec": [
        "skin",
        "verify",
        "dist/{workflow_id}/atlas",
        "--skin",
        "{skin}"
      ],
      "params": {
        "skin": {"default": "skeleton", "label": "皮肤", "choices": ["skeleton", "mannequin"]}
      },
      "depends": [
        "export.artifacts"
      ],
      "collect": [],
      "description": "校验皮肤绑定与锚点，输出 rest 贴合 IoU（皮肤可替换：换 skins/<name>.json + atlas 即可）"
    },
    {
      "action_id": "skin.render",
      "title": "蒙皮合成预览",
      "phase": "skin",
      "exec": [
        "skin",
        "render",
        "{motion}",
        "--view",
        "{view}",
        "--stage",
        "arms",
        "--skin",
        "{skin}",
        "--atlas",
        "dist/{workflow_id}/atlas",
        "--gif",
        "dist/{workflow_id}/skins/{skin}_{motion}_{view}.gif"
      ],
      "params": {
        "skin": {"default": "skeleton", "label": "皮肤", "choices": ["skeleton", "mannequin"]},
        "motion": {"default": "walk", "label": "动作", "choices": ["walk", "run", "idle", "jump"]},
        "view": {"default": "front", "label": "视角", "choices": ["front", "side", "back"]}
      },
      "depends": [
        "skin.verify"
      ],
      "collect": [
        "dist/{workflow_id}/skins/{skin}_{motion}_{view}.gif"
      ],
      "description": "程序化蒙皮：把皮肤部件贴到骨架关节合成动画（侧/背可用 assetslab skin render --view side/back 单独生成）"
    }
  ]
}