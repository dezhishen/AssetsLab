{
  "definition_id": "default",
  "title": "AssetsLab 骨架优先行走流水线（精简版）",
  "actions": [
    {
      "action_id": "skeleton.front",
      "title": "正面行走循环",
      "phase": "skeleton",
      "exec": [
        "stage",
        "front",
        "arms",
        "--renderer",
        "python",
        "--motion",
        "walk",
        "--stride",
        "{stride}",
        "--pelvis-bob",
        "{pelvis_bob}",
        "--arm-swing",
        "{arm_swing}",
        "--proportion-arm-length",
        "{arm_length}",
        "--proportion-leg-length",
        "{leg_length}",
        "--proportion-torso-length",
        "{torso_length}",
        "--proportion-shoulder-width",
        "{shoulder_width}",
        "--proportion-head-scale",
        "{head_scale}",
        "--proportion-height",
        "{height}"
      ],
      "params": {
        "stride": {"default": 1.0, "min": 0.0, "max": 2.5, "label": "步幅"},
        "pelvis_bob": {"default": 1.0, "min": 0.0, "max": 3.0, "label": "骨盆起伏"},
        "arm_swing": {"default": 1.0, "min": 0.0, "max": 2.0, "label": "摆臂"},
        "arm_length": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "臂长"},
        "leg_length": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "腿长"},
        "torso_length": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "躯干长"},
        "shoulder_width": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "肩宽"},
        "head_scale": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "头大小"},
        "height": {"default": 1.0, "min": 0.8, "max": 1.4, "label": "身高"}
      },
      "depends": [],
      "collect": [
        "prototype/test_output/skeleton_pipeline/front_arm_swing.gif"
      ],
      "approval": "human",
      "description": "正面完整行走循环，可调整步幅、骨盆起伏、摆臂与体型比例"
    },
    {
      "action_id": "skeleton.side",
      "title": "右向侧面行走循环",
      "phase": "skeleton",
      "exec": [
        "stage",
        "side",
        "arms",
        "--renderer",
        "python",
        "--motion",
        "walk",
        "--stride",
        "{stride}",
        "--pelvis-bob",
        "{pelvis_bob}",
        "--arm-swing",
        "{arm_swing}",
        "--proportion-arm-length",
        "{arm_length}",
        "--proportion-leg-length",
        "{leg_length}",
        "--proportion-torso-length",
        "{torso_length}",
        "--proportion-shoulder-width",
        "{shoulder_width}",
        "--proportion-head-scale",
        "{head_scale}",
        "--proportion-height",
        "{height}"
      ],
      "params": {
        "stride": {"default": 1.0, "min": 0.0, "max": 2.5, "label": "步幅"},
        "pelvis_bob": {"default": 1.0, "min": 0.0, "max": 3.0, "label": "骨盆起伏"},
        "arm_swing": {"default": 1.0, "min": 0.0, "max": 2.0, "label": "摆臂"},
        "arm_length": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "臂长"},
        "leg_length": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "腿长"},
        "torso_length": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "躯干长"},
        "shoulder_width": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "肩宽"},
        "head_scale": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "头大小"},
        "height": {"default": 1.0, "min": 0.8, "max": 1.4, "label": "身高"}
      },
      "depends": [
        "skeleton.front"
      ],
      "collect": [
        "prototype/test_output/skeleton_pipeline/side_arm_swing.gif"
      ],
      "approval": "human",
      "description": "右向侧面完整行走循环，可调整步幅、骨盆起伏、摆臂与体型比例"
    },
    {
      "action_id": "skeleton.back",
      "title": "背面行走循环",
      "phase": "skeleton",
      "exec": [
        "stage",
        "back",
        "legs",
        "--renderer",
        "python",
        "--motion",
        "walk",
        "--stride",
        "{stride}",
        "--pelvis-bob",
        "{pelvis_bob}",
        "--proportion-arm-length",
        "{arm_length}",
        "--proportion-leg-length",
        "{leg_length}",
        "--proportion-torso-length",
        "{torso_length}",
        "--proportion-shoulder-width",
        "{shoulder_width}",
        "--proportion-head-scale",
        "{head_scale}",
        "--proportion-height",
        "{height}"
      ],
      "params": {
        "stride": {"default": 1.0, "min": 0.0, "max": 2.5, "label": "步幅"},
        "pelvis_bob": {"default": 1.0, "min": 0.0, "max": 3.0, "label": "骨盆起伏"},
        "arm_length": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "臂长"},
        "leg_length": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "腿长"},
        "torso_length": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "躯干长"},
        "shoulder_width": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "肩宽"},
        "head_scale": {"default": 1.0, "min": 0.6, "max": 1.6, "label": "头大小"},
        "height": {"default": 1.0, "min": 0.8, "max": 1.4, "label": "身高"}
      },
      "depends": [
        "skeleton.side"
      ],
      "collect": [
        "prototype/test_output/skeleton_pipeline/back_legs.gif"
      ],
      "approval": "human",
      "description": "背面行走循环，可调整步幅、骨盆起伏与体型比例"
    },
    {
      "action_id": "test.smoke",
      "title": "无头冒烟测试",
      "phase": "test",
      "exec": [
        "test"
      ],
      "depends": [
        "skeleton.back"
      ],
      "collect": [],
      "approval": "auto",
      "description": "生成随机外观并校验全部资产，再跑 Godot 冒烟测试"
    },
    {
      "action_id": "capture.walk",
      "title": "捕获行走 GIF",
      "phase": "capture",
      "exec": [
        "capture-walk"
      ],
      "depends": [
        "test.smoke"
      ],
      "collect": [
        "prototype/test_output/movement_walk.gif"
      ],
      "approval": "human",
      "description": "四方向行走 GIF 捕获"
    },
    {
      "action_id": "preview.publish",
      "title": "发布预览快照",
      "phase": "preview",
      "exec": [
        "publish"
      ],
      "depends": [
        "capture.walk"
      ],
      "collect": [],
      "approval": "human",
      "description": "重建预览资产并发布时间戳快照"
    },
    {
      "action_id": "export.artifacts",
      "title": "导出 Godot 制品",
      "phase": "export",
      "exec": [
        "run-script",
        "export_artifacts.py",
        "--workflow-id",
        "{workflow_id}"
      ],
      "depends": [
        "preview.publish"
      ],
      "collect": [],
      "approval": "human",
      "description": "打包 dist/<workflow_id>/ 制品包（atlas + manifest + GIF）供 Godot demo 使用"
    }
  ]
}