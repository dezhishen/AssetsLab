{
  "schema": "assetslab_motion_v1",
  "motion_id": "idle",
  "title": "Idle — 待机呼吸",
  "description": "Breathing idle: subtle pelvis bob, tiny arm sway, feet planted. No leg cycle; arms breathe in counter-phase.",
  "frame_count": 8,
  "params": {
    "pelvis_bob": {"default": 1.0, "min": 0.0, "max": 3.0, "label": "呼吸起伏"},
    "arm_swing":  {"default": 1.0, "min": 0.0, "max": 2.0, "label": "手臂轻摆"}
  },
  "signals": {
    "phase": {"phase": true},
    "breath": {"sin": {"phase": true}},
    "sway":   {"sin": {"add": [{"phase": true}, 1.0]}},
    "arm":    {"mul": [{"sin": {"add": [{"phase": true}, 1.5]}}, {"param": "arm_swing"}]}
  },
  "offsets": {
    "front": {
      "pelvis": {
        "pelvis":    {"mul": [{"signal": "breath"}, {"param": "pelvis_bob"}, 1.5]},
        "left_hip":  {"mul": [{"signal": "breath"}, {"param": "pelvis_bob"}, 1.5]},
        "right_hip": {"mul": [{"signal": "breath"}, {"param": "pelvis_bob"}, 1.5]},
        "head":     {"x": {"mul": [{"signal": "sway"}, 1.5]}, "y": {"mul": [{"signal": "breath"}, {"param": "pelvis_bob"}, 1.2]}},
        "neck":     {"x": {"mul": [{"signal": "sway"}, 1.5]}, "y": {"mul": [{"signal": "breath"}, {"param": "pelvis_bob"}, 1.2]}}
      },
      "arms": {
        "left_elbow":  {"x": {"mul": [{"signal": "arm"}, 2]}, "y": {"mul": [{"signal": "arm"}, 3]}},
        "left_hand":   {"x": {"mul": [{"signal": "arm"}, 4]}, "y": {"mul": [{"signal": "arm"}, 6]}},
        "right_elbow": {"x": {"mul": [{"signal": "arm"}, -2]}, "y": {"mul": [{"signal": "arm"}, -3]}},
        "right_hand":  {"x": {"mul": [{"signal": "arm"}, -4]}, "y": {"mul": [{"signal": "arm"}, -6]}}
      }
    },
    "side": {
      "pelvis": {
        "pelvis":   {"mul": [{"signal": "breath"}, {"param": "pelvis_bob"}, 1.5]},
        "rear_hip": {"mul": [{"signal": "breath"}, {"param": "pelvis_bob"}, 1.5]},
        "front_hip": {"mul": [{"signal": "breath"}, {"param": "pelvis_bob"}, 1.5]},
        "head":     {"x": {"mul": [{"signal": "sway"}, 1.5]}, "y": {"mul": [{"signal": "breath"}, {"param": "pelvis_bob"}, 1.2]}},
        "neck":     {"x": {"mul": [{"signal": "sway"}, 1.5]}, "y": {"mul": [{"signal": "breath"}, {"param": "pelvis_bob"}, 1.2]}}
      },
      "arms": {
        "rear_elbow":  {"x": {"mul": [{"signal": "arm"}, 2]}, "y": {"mul": [{"signal": "arm"}, 3]}},
        "rear_hand":   {"x": {"mul": [{"signal": "arm"}, 4]}, "y": {"mul": [{"signal": "arm"}, 6]}},
        "front_elbow": {"x": {"mul": [{"signal": "arm"}, -2]}, "y": {"mul": [{"signal": "arm"}, -3]}},
        "front_hand":  {"x": {"mul": [{"signal": "arm"}, -4]}, "y": {"mul": [{"signal": "arm"}, -6]}}
      }
    }
  },
  "selectors": {
    "front_leg":     {"const": "left"},
    "foreground_leg": {"const": "front"},
    "foreground":     {"const": "left"}
  }
}
