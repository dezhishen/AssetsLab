{
  "schema": "assetslab_motion_v1",
  "motion_id": "run",
  "title": "Run — 弹跳跑步循环",
  "description": "Higher stride, deeper pelvis bob and more knee lift than walk. Declares two-bone IK leg groups so the limbs keep their rest-pose length at the larger amplitudes (enable with --ik).",
  "frame_count": 8,
  "params": {
    "stride":     {"default": 1.8, "min": 0.0, "max": 3.0, "label": "步幅"},
    "pelvis_bob": {"default": 1.4, "min": 0.0, "max": 3.0, "label": "弹跳幅度"},
    "arm_swing":  {"default": 1.6, "min": 0.0, "max": 2.5, "label": "摆臂"}
  },
  "signals": {
    "phase":     {"phase": true},
    "sin":       {"mul": [{"sin": {"phase": true}}, {"param": "stride"}]},
    "sin_r":     {"neg": {"signal": "sin"}},
    "sin_rect":  {"rect": {"signal": "sin"}},
    "sin_r_rect": {"rect": {"signal": "sin_r"}},
    "cos":       {"mul": [{"cos": {"phase": true}}, {"param": "stride"}]},
    "arm_left":  {"neg": {"mul": [{"sin": {"phase": true}}, {"param": "arm_swing"}]}},
    "arm_right": {"neg": {"signal": "arm_left"}},
    "arm_cos":   {"mul": [{"cos": {"phase": true}}, {"param": "arm_swing"}]},
    "bob":       {"mul": [{"table": [-4, -3, 2, 5, -4, -3, 2, 5]}, {"param": "pelvis_bob"}]},
    "rear_lift": {"table": [0, 0.7071067811865476, 1.0, 0.7071067811865476, 0, 0, 0, 0]},
    "front_lift": {"table": [0, 0, 0, 0, 0, 0.7071067811865476, 1.0, 0.7071067811865476]}
  },
  "root": {
    "dx": -6,
    "dy": {"signal": "bob"}
  },
  "offsets": {
    "front": {
      "legs": {
        "left_knee":  {"x": {"mul": [{"signal": "sin"}, 20]}, "y": {"mul": [{"signal": "sin_rect"}, -30]}},
        "right_knee": {"x": {"mul": [{"signal": "sin_r"}, 20]}, "y": {"mul": [{"signal": "sin_r_rect"}, -30]}},
        "left_foot":  {"x": {"mul": [{"signal": "sin"}, 32]}, "y": {"mul": [{"signal": "sin_rect"}, -38]}},
        "right_foot": {"x": {"mul": [{"signal": "sin_r"}, 32]}, "y": {"mul": [{"signal": "sin_r_rect"}, -38]}}
      },
      "arms": {
        "left_elbow":  {"x": {"mul": [{"signal": "arm_left"}, 8]}, "y": {"mul": [{"signal": "arm_left"}, 10]}},
        "left_hand":   {"x": {"mul": [{"signal": "arm_left"}, 16]}, "y": {"mul": [{"signal": "arm_left"}, 22]}},
        "right_elbow": {"x": {"mul": [{"signal": "arm_right"}, 8]}, "y": {"mul": [{"signal": "arm_right"}, 10]}},
        "right_hand":  {"x": {"mul": [{"signal": "arm_right"}, 16]}, "y": {"mul": [{"signal": "arm_right"}, 22]}}
      }
    },
    "side": {
      "legs": {
        "rear_knee":  {"x": {"add": [18, {"mul": [{"signal": "cos"}, -24]}]}, "y": {"mul": [{"signal": "rear_lift"}, -28]}},
        "front_knee": {"x": {"add": [-18, {"mul": [{"signal": "cos"}, 24]}]}, "y": {"mul": [{"signal": "front_lift"}, -28]}},
        "rear_foot":  {"x": {"add": [30, {"mul": [{"signal": "cos"}, -40]}]}, "y": {"mul": [{"signal": "rear_lift"}, -40]}},
        "front_foot": {"x": {"add": [-30, {"mul": [{"signal": "cos"}, 40]}]}, "y": {"mul": [{"signal": "front_lift"}, -40]}}
      },
      "pelvis": {
        "head": {"x": {"mul": [{"cos": {"phase": true}}, 5]}},
        "neck": {"x": {"mul": [{"cos": {"phase": true}}, 5]}}
      },
      "arms": {
        "rear_elbow":  {"x": {"mul": [{"signal": "arm_cos"}, 10]}, "y": {"mul": [{"signal": "arm_cos"}, 5]}},
        "rear_hand":   {"x": {"mul": [{"signal": "arm_cos"}, 20]}, "y": {"mul": [{"signal": "arm_cos"}, 10]}},
        "front_elbow": {"x": {"mul": [{"signal": "arm_cos"}, -10]}, "y": {"mul": [{"signal": "arm_cos"}, -5]}},
        "front_hand":  {"x": {"mul": [{"signal": "arm_cos"}, -20]}, "y": {"mul": [{"signal": "arm_cos"}, -10]}}
      }
    },
    "back": {
      "legs": {
        "left_knee":  {"x": {"mul": [{"signal": "sin"}, 20]}, "y": {"mul": [{"signal": "sin_rect"}, -30]}},
        "right_knee": {"x": {"mul": [{"signal": "sin_r"}, 20]}, "y": {"mul": [{"signal": "sin_r_rect"}, -30]}},
        "left_foot":  {"x": {"mul": [{"signal": "sin"}, 32]}, "y": {"mul": [{"signal": "sin_rect"}, -38]}},
        "right_foot": {"x": {"mul": [{"signal": "sin_r"}, 32]}, "y": {"mul": [{"signal": "sin_r_rect"}, -38]}},
        "head":      {"y": {"mul": [{"signal": "bob"}, 0.4]}},
        "neck":      {"y": {"mul": [{"signal": "bob"}, 0.4]}}
      }
    }
  },
  "selectors": {
    "front_leg":     {"table": ["left", "left", "left", "left", "right", "right", "right", "right"]},
    "foreground_leg": {"table": ["front", "rear", "rear", "rear", "rear", "front", "front", "front"]},
    "foreground":     {"table": ["left", "left", "left", "left", "right", "right", "right", "right"]}
  },
  "ik": {
    "front": {"legs": {
      "left": {"hip": "left_hip", "knee": "left_knee", "foot": "left_foot"},
      "right": {"hip": "right_hip", "knee": "right_knee", "foot": "right_foot"}
    }},
    "side": {"legs": {
      "rear": {"hip": "rear_hip", "knee": "rear_knee", "foot": "rear_foot"},
      "front": {"hip": "front_hip", "knee": "front_knee", "foot": "front_foot"}
    }},
    "back": {"legs": {
      "left": {"hip": "left_hip", "knee": "left_knee", "foot": "left_foot"},
      "right": {"hip": "right_hip", "knee": "right_knee", "foot": "right_foot"}
    }}
  }
}
