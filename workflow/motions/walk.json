{
  "schema": "assetslab_motion_v1",
  "motion_id": "walk",
  "title": "Walk — 8 帧标准行走",
  "description": "Default walk cycle. Produces the same joint positions as the built-in Godot pose math (front/side/back, stride/pelvis-bob/arm-swing), so --style consistent output is unchanged.",
  "frame_count": 8,
  "params": {
    "stride":     {"default": 1.0, "min": 0.0, "max": 2.5, "label": "步幅"},
    "pelvis_bob": {"default": 1.0, "min": 0.0, "max": 3.0, "label": "骨盆起伏"},
    "arm_swing":  {"default": 1.0, "min": 0.0, "max": 2.0, "label": "摆臂"}
  },
  "signals": {
    "phase":     {"phase": true},
    "sin":       {"mul": [{"sin": {"phase": true}}, {"param": "stride"}]},
    "sin_r":     {"neg": {"signal": "sin"}},
    "sin_rect":  {"rect": {"signal": "sin"}},
    "sin_r_rect": {"rect": {"signal": "sin_r"}},
    "cos":       {"mul": [{"cos": {"phase": true}}, {"param": "stride"}]},
    "arm_left":  {"neg": {"mul": [{"sin": {"phase": true}}, {"param": "arm_swing"}]}},
    "arm_right": {"neg": {"signal": "arm_left"}},
    "arm_cos":   {"mul": [{"cos": {"phase": true}}, {"param": "arm_swing"}]},
    "bob":       {"mul": [{"table": [-2, -1, 1, 3, -2, -1, 1, 3]}, {"param": "pelvis_bob"}]},
    "rear_lift": {"table": [0, 0.7071067811865476, 1.0, 0.7071067811865476, 0, 0, 0, 0]},
    "front_lift": {"table": [0, 0, 0, 0, 0, 0.7071067811865476, 1.0, 0.7071067811865476]}
  },
  "offsets": {
    "front": {
      "legs": {
        "left_knee":  {"x": {"mul": [{"signal": "sin"}, 15]}, "y": {"mul": [{"signal": "sin_rect"}, -22]}},
        "right_knee": {"x": {"mul": [{"signal": "sin_r"}, 15]}, "y": {"mul": [{"signal": "sin_r_rect"}, -22]}},
        "left_foot":  {"x": {"mul": [{"signal": "sin"}, 24]}, "y": {"mul": [{"signal": "sin_rect"}, -26]}},
        "right_foot": {"x": {"mul": [{"signal": "sin_r"}, 24]}, "y": {"mul": [{"signal": "sin_r_rect"}, -26]}}
      },
      "pelvis": {
        "pelvis":    {"y": {"signal": "bob"}},
        "left_hip":  {"y": {"signal": "bob"}},
        "right_hip": {"y": {"signal": "bob"}},
        "left_knee":  {"y": {"mul": [{"signal": "bob"}, 0.5]}},
        "right_knee": {"y": {"mul": [{"signal": "bob"}, 0.5]}}
      },
      "arms": {
        "left_elbow":  {"x": {"mul": [{"signal": "arm_left"}, 5]}, "y": {"mul": [{"signal": "arm_left"}, 6]}},
        "left_hand":   {"x": {"mul": [{"signal": "arm_left"}, 10]}, "y": {"mul": [{"signal": "arm_left"}, 14]}},
        "right_elbow": {"x": {"mul": [{"signal": "arm_right"}, 5]}, "y": {"mul": [{"signal": "arm_right"}, 6]}},
        "right_hand":  {"x": {"mul": [{"signal": "arm_right"}, 10]}, "y": {"mul": [{"signal": "arm_right"}, 14]}}
      }
    },
    "side": {
      "legs": {
        "rear_knee":  {"x": {"add": [18, {"mul": [{"signal": "cos"}, -18]}]}, "y": {"mul": [{"signal": "rear_lift"}, -20]}},
        "front_knee": {"x": {"add": [-18, {"mul": [{"signal": "cos"}, 18]}]}, "y": {"mul": [{"signal": "front_lift"}, -20]}},
        "rear_foot":  {"x": {"add": [30, {"mul": [{"signal": "cos"}, -30]}]}, "y": {"mul": [{"signal": "rear_lift"}, -30]}},
        "front_foot": {"x": {"add": [-30, {"mul": [{"signal": "cos"}, 30]}]}, "y": {"mul": [{"signal": "front_lift"}, -30]}}
      },
      "pelvis": {
        "pelvis":   {"y": {"signal": "bob"}},
        "rear_hip": {"y": {"signal": "bob"}},
        "front_hip": {"y": {"signal": "bob"}}
      },
      "arms": {
        "rear_elbow":  {"x": {"mul": [{"signal": "arm_cos"}, 7]}, "y": {"mul": [{"signal": "arm_cos"}, 3]}},
        "rear_hand":   {"x": {"mul": [{"signal": "arm_cos"}, 14]}, "y": {"mul": [{"signal": "arm_cos"}, 6]}},
        "front_elbow": {"x": {"mul": [{"signal": "arm_cos"}, -7]}, "y": {"mul": [{"signal": "arm_cos"}, -3]}},
        "front_hand":  {"x": {"mul": [{"signal": "arm_cos"}, -14]}, "y": {"mul": [{"signal": "arm_cos"}, -6]}}
      }
    },
    "back": {
      "legs": {
        "left_knee":  {"x": {"mul": [{"signal": "sin"}, 15]}, "y": {"mul": [{"signal": "sin_rect"}, -22]}},
        "right_knee": {"x": {"mul": [{"signal": "sin_r"}, 15]}, "y": {"mul": [{"signal": "sin_r_rect"}, -22]}},
        "left_foot":  {"x": {"mul": [{"signal": "sin"}, 24]}, "y": {"mul": [{"signal": "sin_rect"}, -26]}},
        "right_foot": {"x": {"mul": [{"signal": "sin_r"}, 24]}, "y": {"mul": [{"signal": "sin_r_rect"}, -26]}}
      }
    }
  },
  "selectors": {
    "front_leg":     {"table": ["left", "left", "left", "left", "right", "right", "right", "right"]},
    "foreground_leg": {"table": ["front", "rear", "rear", "rear", "rear", "front", "front", "front"]},
    "foreground":     {"table": ["left", "left", "left", "left", "right", "right", "right", "right"]}
  }
}
