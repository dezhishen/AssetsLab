    "lower_body": { "joint": "pelvis",      "anchor": null, "rotate": false, "anchor_policy": "center" },
    "arms":       { "joint": "shoulder_%s", "anchor": null, "rotate": false, "limb": "left/right", "anchor_policy": "center" },
    "torso":      { "joint": "pelvis",      "anchor": null, "rotate": false, "anchor_policy": "center" },
    "head_base":  { "joint": "head",        "anchor": null, "rotate": false, "anchor_policy": "center" },
    "ear":        { "joint": "head",        "anchor": null, "rotate": false, "anchor_policy": "center" },
    "face":       { "joint": "head",        "anchor": null, "rotate": false, "anchor_policy": "center" }
  },
  "limbs": { "arms": ["left", "right"], "feet": ["left", "right"] },
  "anchors": {}
}
